---
// ─────────────────────────────────────────────────────────────
// /publications - every paper, grouped by year, newest first.
// Data comes from src/data/publications.js.
// ─────────────────────────────────────────────────────────────
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications } from '../data/publications.js';

// group by year → [['2026', [pub,…]], …] sorted descending
const byYear = new Map<number, typeof publications>();
for (const pub of publications) {
  if (!byYear.has(pub.year)) byYear.set(pub.year, []);
  byYear.get(pub.year)!.push(pub);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const statusLabel = (s: string) => (s === 'review' ? 'Under review' : s === 'published' ? 'Published' : s);
const statusClass = (s: string) => (s === 'review' ? 'rev' : s === 'published' ? 'publ' : 'publ');
---

<BaseLayout title={`Publications - Abhishek Ajith`}>
  <section>
    <div class="sec-head rv visible">
      <span class="sec-tag">Publications</span>
      <h2>All Publications</h2>
    </div>

    <div class="pub-list" style="max-width:none">
      {years.map((year) => (
        <>
          <h2 class="yr" style="font-size:1.9rem;margin:34px 0 6px">{year}</h2>
          {byYear.get(year)!.map((pub) => (
            <div class="pub">
              <div>
                <h4>{pub.url ? <a href={pub.url} target="_blank" rel="noopener" style="color:var(--teal)">{pub.title}</a> : pub.title}</h4>
                <div class="meta">
                  <Fragment set:html={pub.authors.replace(/Ajith A\./, '<strong>Ajith A.</strong>')} />
                  {' - '}<em>{pub.venue}</em>
                </div>
                <span class={`badge ${statusClass(pub.status)}`}>{statusLabel(pub.status)}</span>
              </div>
            </div>
          ))}
        </>
      ))}
    </div>
  </section>
</BaseLayout>
