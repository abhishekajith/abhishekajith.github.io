---
import { Image } from 'astro:assets'

import SocialIcons from './SocialIcons.astro'


const {fullName, title, institute, profilePicture} = Astro.props
---
<div class='flex-1'>
  <h1 class='text-4xl font-bold mb-4'>
    Welcome! I'm <span class='text-secondary'>{fullName}</span>
  </h1>
  <p class='text-xl text-gray-600 mb-4'>{title}{institute ? ` at ${institute}` : ''}</p>
  <p class='text-lg mb-6'>
    I design inherently radiopaque, biodegradable biomaterials — implants that are
    visible under X-ray, osteogenic, and resorb after healing — for orthopaedic repair
    and locoregional cancer therapy.
  </p>
  <div class='flex gap-4 items-center'>
    <SocialIcons />
  </div>
</div>
<div class='size-72 lg:block hidden'>
  <Image
    src={profilePicture}
    alt={fullName}
    class='w-full h-full mask mask-circle size-44'
  />
</div>
