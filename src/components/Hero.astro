---
// ─────────────────────────────────────────────────────────────
// HERO - first screen: animated cell canvas behind a two-column
// grid of ring-framed portrait (left) + headline text (right).
// Animation logic lives in src/scripts/cells.js.
// ─────────────────────────────────────────────────────────────
import { site } from '../data/site.js';
---

<header class="hero">
  <canvas id="cells"></canvas>

  <div class="hero-grid">
    <!-- portrait FIRST = photo sits LEFT of the headline on desktop,
         and stacks above the text on narrow screens -->
    <div class="portrait-wrap">
      <img src={site.portrait} alt={site.portraitAlt} width="720" height="720" loading="eager" />
      <span class="mini-cell mc1"></span><span class="mini-cell mc2"></span><span class="mini-cell mc3"></span>
    </div>

    <div class="hero-inner">
      <a class="kicker" href={site.lab.url} target="_blank" rel="noopener" title={site.lab.title}>
        {site.lab.label}
      </a>

      <h1>
        {site.headlineBefore}<br /><em>{site.headlineAccent}</em>{site.headlineAfter}
      </h1>
      <p class="sub">{site.intro}</p>

      <div class="cta-row">
        <a class="btn fill" href="#work">Explore research</a>
        <a class="btn line" href={site.cvUrl} target="_blank" rel="noopener">Download CV ↓</a>
      </div>
    </div>
  </div>
</header>

<!-- wave divider (pure decoration) -->
<svg class="divider" viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true">
  <path d="M0 46 C260 12 520 62 760 34 C1000 8 1240 54 1440 26 L1440 64 L0 64 Z" fill="var(--line)" opacity=".45"></path>
</svg>

<!-- load + start the cell animation -->
<script>
  import '../scripts/cells.js';
</script>
